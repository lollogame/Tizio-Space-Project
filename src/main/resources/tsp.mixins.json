{
  "required": true,
  "minVersion": "0.8",
  "package": "tizio.dev.tsp.mixin",
  "compatibilityLevel": "JAVA_8",
  "refmap": "tsp.refmap.json",
  "mixins": [
    "entity.NoVoidDamage",

    "gravity.AbstractArrowGravityMixin",
    "gravity.FallingBlockEntityGravityMixin",
    "gravity.ItemEntityGravityMixin",
    "gravity.PrimedTntGravityMixin",
    "gravity.ThrowableProjectileGravityMixin"

  ],
  "client": [
    "render.DepthMixin",

    "render.lighting.GameRendererMixin",
    "render.lighting.DiffuseLightingMixin",
    "render.lighting.ShadingLevelMixin",

    "render.LevelRendererCloudsMixin",
    "render.FPSArmRenderMixin",
    "other.ReceivingLevelScreenMixin"
  ],
